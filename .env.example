TZ=UTC
PORT=3402
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

BLOG_AI_URL=http://localhost:8402
BLOG_AI_TIMEOUT_MS=60000
# Arranca en false a proposito: el ejercicio de este modulo empieza viendo el sistema
# SIN nadie vigilando el limite entre servicios, y la vigilancia se enciende despues,
# que es cuando significa algo. Ponlo en true para que blog-api valide cada respuesta
# de blog-ai contra contracts/blog-ai.openapi.json y devuelva 502 si no cumple.
# (El valor por defecto del codigo, si esta variable no existe, sigue siendo true.)
CONTRATO_ESTRICTO=false